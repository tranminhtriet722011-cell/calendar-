# APE environment template — copy values into your shell environment.
#
# The application reads these from the process environment; it does NOT parse this file itself
# and it contains no secrets of any kind. Defaults are safe for local development.

# TCP port for the API and (in production mode) the built client. Bound to 127.0.0.1 only.
APE_PORT=8787

# SQLite database file. Created on first run. Never commit this file.
APE_DB_FILE=./data/ape.db

# Directory with the built single-page client. Leave unset while using `npm run dev`.
APE_STATIC=./dist/client
