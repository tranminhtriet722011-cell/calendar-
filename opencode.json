{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "ape-builder",
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },

    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "edit", "resource": "*.env", "effect": "deny" },
    { "action": "edit", "resource": "*.env.*", "effect": "deny" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "secrets/*", "effect": "deny" },
    { "action": "edit", "resource": "secrets/*", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "edit", "resource": "*.pem", "effect": "deny" },
    { "action": "edit", "resource": "*.key", "effect": "deny" },

    { "action": "external_directory", "resource": "*", "effect": "ask" },

    { "action": "shell", "resource": "git push *", "effect": "deny" },
    { "action": "shell", "resource": "git remote *", "effect": "ask" },
    { "action": "shell", "resource": "git reset *", "effect": "ask" },
    { "action": "shell", "resource": "git clean *", "effect": "ask" },
    { "action": "shell", "resource": "git checkout *", "effect": "ask" },
    { "action": "shell", "resource": "git branch -D *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *-Recurse*", "effect": "ask" },
    { "action": "shell", "resource": "Remove-Item *-Force*", "effect": "ask" },
    { "action": "shell", "resource": "rd *", "effect": "ask" },
    { "action": "shell", "resource": "rmdir *", "effect": "ask" },
    { "action": "shell", "resource": "del *", "effect": "ask" },

    { "action": "shell", "resource": "npm publish *", "effect": "deny" },
    { "action": "shell", "resource": "npm run deploy*", "effect": "deny" },
    { "action": "shell", "resource": "vercel *", "effect": "deny" },
    { "action": "shell", "resource": "netlify *", "effect": "deny" },
    { "action": "shell", "resource": "flyctl *", "effect": "deny" },
    { "action": "shell", "resource": "heroku *", "effect": "deny" },
    { "action": "shell", "resource": "railway *", "effect": "deny" },
    { "action": "shell", "resource": "aws *", "effect": "deny" },
    { "action": "shell", "resource": "gcloud *", "effect": "deny" },
    { "action": "shell", "resource": "az *", "effect": "deny" },
    { "action": "shell", "resource": "docker push *", "effect": "deny" },
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "Invoke-WebRequest *", "effect": "ask" },
    { "action": "shell", "resource": "gh *", "effect": "ask" },

    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" }
  ],
  "watcher": {
    "ignore": ["data/**", "dist/**", "node_modules/**", "coverage/**"]
  }
}
